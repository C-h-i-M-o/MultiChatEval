# Backend
APP_NAME=MultiChatEval
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=mysql+aiomysql://multichateval:multichateval@localhost:3306/multichateval

# Model providers
MODEL_REQUEST_TIMEOUT=90

